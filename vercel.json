{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "rewrites": [
    { "source": "/contabilidad/api/:path*", "destination": "/api/erp-proxy/:path*" },
    { "source": "/contabilidad", "destination": "https://atrion-core.vercel.app/contabilidad" },
    { "source": "/contabilidad/:path*", "destination": "https://atrion-core.vercel.app/contabilidad/:path*" },
    {
      "source": "/((?!api|contabilidad|@|_|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
