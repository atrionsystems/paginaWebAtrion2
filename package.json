{
  "name": "atrion-systems",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:api": "vitest run tests",
    "test:odoo-live": "node --env-file=.env ./node_modules/vitest/vitest.mjs run integration-live/odoo-live.spec.ts",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p api/tsconfig.json --noEmit",
    "format:check": "prettier --check api/contact.ts server/contact tests integration-live README.md"
  },
  "private": true,
  "packageManager": "npm@11.11.0",
  "dependencies": {
    "@angular/common": "^21.2.18",
    "@angular/compiler": "^21.2.18",
    "@angular/core": "^21.2.18",
    "@angular/forms": "^21.2.18",
    "@angular/platform-browser": "^21.2.18",
    "@angular/router": "^21.2.18",
    "nodemailer": "^9.0.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.19",
    "@angular/cli": "^21.2.19",
    "@angular/compiler-cli": "^21.2.18",
    "@types/nodemailer": "^8.0.1",
    "@vercel/node": "^5.8.3",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
